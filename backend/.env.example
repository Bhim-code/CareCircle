# Copy to .env and change the values. Never commit .env.

# development | test | production   ("production" hides /docs and forces HTTPS)
ENVIRONMENT=development

# PostgreSQL. Matches docker-compose.yml; change the password for anything shared.
DATABASE_URL=postgresql+psycopg://carecircle:carecircle@localhost:5432/carecircle

# Used only by the tests (pytest). A separate database so tests never touch your data.
TEST_DATABASE_URL=postgresql+psycopg://carecircle:carecircle@localhost:5432/carecircle_test

# Browser origins allowed to call the API (the admin panel), comma-separated.
# The mobile app does not need an entry here; CORS only applies to browsers.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Sign-in ---------------------------------------------------------------
# Signs access tokens. At least 32 random characters, different per environment.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-before-you-share-this
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
# The link in the reset email. The app opens it and calls /auth/password-reset/confirm.
PASSWORD_RESET_URL=carecircle://reset-password

# --- Protection ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Set true when the API runs behind a proxy/load balancer (Render, Railway, nginx).
TRUST_PROXY_HEADERS=false
# Refuse plain HTTP. Leave empty to use the default (on only in production).
FORCE_HTTPS=

# --- Photos ----------------------------------------------------------------
# Private folder for uploaded photos. Never serve this folder directly.
PHOTO_DIR=storage/photos
# How long a photo link works.
PHOTO_LINK_MINUTES=15
# This API's public address, used to build photo links (e.g. https://api.example.com).
# Empty = links are relative (/files/photos/...).
PUBLIC_BASE_URL=

# --- Email, calls and push (background jobs) --------------------------------
# Empty SMTP_HOST = emails are written to the log instead of being sent (demo mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CareCircle <no-reply@carecircle.local>
SMTP_STARTTLS=true
# log = write push notifications to the log;  expo = send through Expo's push service
PUSH_PROVIDER=log
# Minutes after the scheduled time before a dose counts as missed.
MISSED_DOSE_AFTER_MINUTES=60
