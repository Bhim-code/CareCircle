{
  "expo": {
    "name": "CareCircle",
    "slug": "carecircle",
    "version": "1.0.0",
    "scheme": "carecircle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEF4F6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carecircle.app"
    },
    "android": {
      "package": "com.carecircle.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-notifications",
        {
          "color": "#1F5F7A"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CareCircle uses the camera only to photograph a medicine or a health document.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CareCircle reads a photo only when you choose one to add as a health document.",
          "cameraPermission": "CareCircle uses the camera only to photograph a medicine or a health document.",
          "microphonePermission": false
        }
      ],
      "./plugins/withShowWhenLocked",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70c0af75-7018-415f-91aa-624eb79d7c72"
      }
    },
    "owner": "biplava"
  }
}
