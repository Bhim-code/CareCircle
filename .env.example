# Copy to .env and fill in. Find both values in Supabase: Project Settings -> API.
# These are public by design (the anon key is protected by Row Level Security).
# Never put the service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Development only. Forces the in-memory demo backend even when Supabase is configured.
# Ignored in release builds.
EXPO_PUBLIC_DEMO_MODE=false
