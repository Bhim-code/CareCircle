{
  "name": "carecircle-admin",
  "private": true,
  "description": "CareCircle admin panel. Plain HTML + JS; Tailwind is only needed to rebuild the CSS.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o assets/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o assets/app.css --watch",
    "fonts": "node -e \"const fs=require('fs');fs.mkdirSync('assets/fonts',{recursive:true});for(const w of ['400','700'])fs.copyFileSync('node_modules/@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-'+w+'-normal.woff2','assets/fonts/atkinson-'+w+'.woff2')\"",
    "serve": "python -m http.server 5500"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.6",
    "tailwindcss": "3.4.17"
  }
}
